# ./start.sh が無ければ自動生成します (BRIDGE_TOKEN は自動でランダム生成)
BRIDGE_TOKEN=change-me
BRIDGE_PORT=8765
# macOS/Windows(Docker Desktop) は 127.0.0.1 のままでOK。
# Linux の Docker は 0.0.0.0 にする必要があります(トークン必須。FWで外部公開しないこと)
BRIDGE_HOST=127.0.0.1
# 1 = 全ツール自動許可(full)を標準にする。安全側にしたい場合は 0 (画面でもsafeに切替可)
BRIDGE_ALLOW_FULL=1
# AIが作業するフォルダ
BRIDGE_WORKDIR=~/jarvis-workspace
WEB_PORT=3210
# VOICEVOX エンジンを Docker で一緒に起動する(使わないなら空欄に)
COMPOSE_PROFILES=voicevox
# Kiro を常駐させて高速化(0で無効＝毎回CLI起動)
BRIDGE_KIRO_ACP=1
